      "timestamp",
      "incident_category",
      "country_code",
      "escalation_level",
      "authority_shown",
      "alert_sent_to"
    ],
    "fail_closed": true,
    "max_config_age_days": 365
  },
  "incident_categories": {
    "danger_physique_immédiat": {
      "urgence": 3,
      "route": "emergency_only"
    },
    "maltraitance_suspicion": {
      "urgence": 2,
      "route": "child_protection"
    },
    "risque_suicidaire": {
      "urgence": 3,
      "route": "mental_health_emergency"
    },
    "CSAM": {
      "urgence": 3,
      "route": "csam_hotline",
      "never_store_content": true
    },
    "grooming": {
      "urgence": 2,
      "route": "child_protection"
    },
    "exploitation_sexuelle": {
      "urgence": 3,
      "route": "child_protection"
    },
    "cyberharcèlement": {
      "urgence": 1,
      "route": "cybercrime"
    },
    "menace": {
      "urgence": 2,
      "route": "cybercrime"
    },
    "extorsion": {
      "urgence": 2,
      "route": "cybercrime"
    },
    "violence": {
      "urgence": 2,
      "route": "emergency_or_child_protection"
    },
    "haine_discrimination": {
      "urgence": 1,
      "route": "cybercrime"
    },
    "escroquerie": {
      "urgence": 1,
      "route": "fraud"
    },
    "divulgation_données": {
      "urgence": 1,
      "route": "cybercrime"
    },
    "autre_illicite": {
      "urgence": 1,
      "route": "general"
    }
  },
  "alert_recipients": {
    "rules": [
      {
        "trigger": [
          "danger_physique_immédiat",
          "risque_suicidaire"
        ],
        "recipients": [
          "parent_compte"
        ],
        "delay": "immediate"
      },
      {
        "trigger": [
          "CSAM",
          "grooming",
          "exploitation_sexuelle"
        ],
        "recipients": [
          "parent_compte",
          "forgedis_moderator"
        ],
        "delay": "immediate"
      },
      {
        "trigger": [
          "cyberharcèlement",
          "menace",
          "extorsion",
          "maltraitance_suspicion"
        ],
        "recipients": [
          "parent_compte"
        ],
        "delay": "within_session"
      },
      {
        "trigger": [
          "haine_discrimination",
          "escroquerie",
          "divulgation_données",
          "violence",
          "autre_illicite"
        ],
        "recipients": [
          "parent_compte"
        ],
        "delay": "next_login"
      }
    ],
    "forgedis_moderator": {
      "when": [
        "CSAM",
        "grooming",
        "exploitation_sexuelle"
      ],
      "access": "métadonnées_seulement",
      "never": "contenu_illicite"
    }
  },
  "storage_rules": {
    "never_store_illegal_media": true,
    "allowed_metadata": [
      "timestamp",
      "incident_category",
      "country_code",
      "escalation_level",
      "authority_shown",
      "alert_sent_to"
    ],
    "forbidden": [
      "screenshots",
      "media_content",
      "CSAM_any_form",
      "conversation_verbatim"
    ],
    "retention_days": 90
  },
